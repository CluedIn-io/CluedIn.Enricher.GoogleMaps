<Project>
  <Import Project="..\Directory.Build.props" />

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Package selection (xunit v2 vs v3, AutoFixture.Xunit2 vs Xunit3) is done per test csproj,
       not here - see each test csproj's own conditional ItemGroups. Keeping it here would combine
       a non-CLUEDIN_V50 leg's xunit v2 include with an unconditional xunit v3 include from this
       file, putting both xunit generations in the compile references at once (CS0433). -->
</Project>