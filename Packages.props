<Project>
  <PropertyGroup Label="Dependency Versions">
    <_AutoFixture>5.0.0-preview0012</_AutoFixture>
    <_CluedIn Condition="'$(_CluedIn)' == ''">5.0.0-*</_CluedIn>

    <!-- Strip pre-release suffix for version comparison -->
    <_HyphenIndex>$(_CluedIn.IndexOf('-'))</_HyphenIndex>
    <_CluedInVersionOnly Condition="'$(_HyphenIndex)' != '-1'">$(_CluedIn.Substring(0, $(_HyphenIndex)))</_CluedInVersionOnly>
    <_CluedInVersionOnly Condition="'$(_HyphenIndex)' == '-1'">$(_CluedIn)</_CluedInVersionOnly>

    <!-- Gates conditional compilation (#if CLUEDIN_Vxx) for places where a CluedIn.Core API call
         differs across the targeted version range. -->
    <DefineConstants Condition="$([System.Version]::Parse($(_CluedInVersionOnly))) &gt;= $([System.Version]::Parse('4.7.0'))">$(DefineConstants);CLUEDIN_V47</DefineConstants>
    <DefineConstants Condition="$([System.Version]::Parse($(_CluedInVersionOnly))) &gt;= $([System.Version]::Parse('4.8.0'))">$(DefineConstants);CLUEDIN_V48</DefineConstants>
    <DefineConstants Condition="$([System.Version]::Parse($(_CluedInVersionOnly))) &gt;= $([System.Version]::Parse('5.0.0'))">$(DefineConstants);CLUEDIN_V50</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!--
        Specified versions for dependencies in test projects
        MUST SPECIFY IN CSPROJ AS <PackageReference Name="<depName>" />
    -->
    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="17.12.0" Condition="!$(DefineConstants.Contains('CLUEDIN_V50'))" />
    <PackageReference Update="AutoFixture.Xunit3" Version="$(_AutoFixture)" />
    <PackageReference Update="AutoFixture.Xunit2" Version="4.18.0" />
    <PackageReference Update="coverlet.msbuild" Version="2.8.0" />
    <PackageReference Update="xunit.v3" Version="3.2.2" />
    <PackageReference Update="xunit" Version="2.9.3" />
    <PackageReference Update="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Update="xunit.runner.visualstudio" Version="2.8.2" Condition="!$(DefineConstants.Contains('CLUEDIN_V50'))" />
    <PackageReference Update="Moq" Version="4.13.1" />
    <!-- Not tied to $(_CluedIn): CluedIn.Testing.Base/CluedIn.CrawlerIntegrationTesting were never
         published for the 4.7.0/4.8.0 line (confirmed via restore - nearest available versions
         there are ~4.0.0/4.5.0, well below what this repo's src/ needs). Integration tests always
         run against the newest test-harness version regardless of which CluedIn.Core leg is being
         built; see docs/multi-version-targeting-migration.md Step 6 for the implication this has
         on integration testing older legs. -->
    <PackageReference Update="CluedIn.Testing.Base" Version="5.0.0-*" />
  </ItemGroup>
  <ItemGroup>
    <!--
        Specified versions for dependencies across the solution
        MUST SPECIFY IN CSPROJ AS <PackageReference Name="<depName>" />
    -->
    <PackageReference Update="CluedIn.Crawling" Version="$(_CluedIn)" />
    <PackageReference Update="CluedIn.CrawlerIntegrationTesting" Version="5.0.0-*" />
    <PackageReference Update="CluedIn.Core" Version="$(_CluedIn)" />
    <PackageReference Update="CluedIn.ExternalSearch" Version="$(_CluedIn)" />
  </ItemGroup>
</Project>
